<Window x:Class="PAAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PAAI"
        Width="360" MinHeight="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
  </Window.Resources>

  <Border Background="#1A1A2E" CornerRadius="16"
          BorderBrush="#2D2D4E" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="50"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Header -->
      <Border Grid.Row="0" Background="#12122A" CornerRadius="16,16,0,0">
        <Grid Margin="16,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="8" Height="8" Fill="#A6E3A1" Margin="0,0,8,0"/>
            <TextBlock Text="PAAI" Foreground="White"
                       FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text=" — Personal AI Assistant"
                       Foreground="#6C7086" FontSize="12"
                       VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center">
            <Button Content="⚙" Foreground="#9F9D96"
                    Background="Transparent" BorderThickness="0"
                    FontSize="14" Cursor="Hand"
                    Click="Settings_Click"/>
            <Button Content="─" Foreground="#9F9D96"
                    Background="Transparent" BorderThickness="0"
                    FontSize="14" Cursor="Hand"
                    ToolTip="Minimize"
                    Click="Minimize_Click"/>
            <Button Content="✕" Foreground="#9F9D96"
                    Background="Transparent" BorderThickness="0"
                    FontSize="14" Cursor="Hand"
                    Click="Close_Click"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Chat messages -->
      <ScrollViewer Grid.Row="1" x:Name="ChatScroll"
                    VerticalScrollBarVisibility="Auto"
                    Padding="0,8">
        <ItemsControl x:Name="MessagesList" Margin="12,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,4">
                <Border HorizontalAlignment="Right"
                        MaxWidth="260"
                        Background="#313244"
                        CornerRadius="12,4,12,12"
                        Padding="10,8" Margin="40,0,0,0">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding Text}"
                             Foreground="#CDD6F4"
                             FontSize="13" TextWrapping="Wrap"/>
                </Border>

                <Border HorizontalAlignment="Left"
                        MaxWidth="300"
                        Background="#1E1E3A"
                        CornerRadius="4,12,12,12"
                        Padding="10,8" Margin="0,0,40,0">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Visibility" Value="Visible"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel>
                    <TextBlock Text="PAAI" Foreground="#A6E3A1"
                               FontSize="10" FontWeight="SemiBold"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Text}"
                               Foreground="#CDD6F4"
                               FontSize="13" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Error Banner -->
      <Border Grid.Row="2" x:Name="ErrorBanner"
              Background="#2D1B1B"
              BorderBrush="#F38BA8" BorderThickness="0,1,0,0"
              Padding="12,8" Visibility="Collapsed">
        <Grid>
          <StackPanel>
            <TextBlock Text="Error detect hua!"
                       Foreground="#F38BA8"
                       FontSize="11" FontWeight="SemiBold"/>
            <TextBlock x:Name="ErrorPreview"
                       Foreground="#CDD6F4"
                       FontSize="11" TextWrapping="Wrap"
                       MaxHeight="40"
                       TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Button HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Content="PAAI se poochho →"
                  Foreground="#A6E3A1"
                  Background="Transparent"
                  BorderThickness="0"
                  Cursor="Hand"
                  Click="AskAboutError_Click"/>
        </Grid>
      </Border>

      <!-- NAYA: Project Folder Watch bar -->
      <Border Grid.Row="3" Background="#12122A"
              Padding="12,8"
              BorderBrush="#2D2D4E" BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="WatchedFoldersText"
                     Grid.Column="0"
                     Foreground="#9F9D96" FontSize="11"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"
                     Text="Koi folder watch nahi ho raha"/>
          <Button Grid.Column="1" Content="+ Project Folder"
                  Padding="10,6"
                  Background="#7F77DD"
                  Foreground="White"
                  BorderThickness="0"
                  Cursor="Hand"
                  FontSize="11"
                  Click="SelectFolder_Click"/>
        </Grid>
      </Border>

      <!-- Browser Watch bar -->
      <Border Grid.Row="4" Background="#12122A"
              Padding="12,8"
              BorderBrush="#2D2D4E" BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="BrowserUrlBox"
                   Background="#1E1E3A"
                   Foreground="#6C7086"
                   BorderBrush="#313244" BorderThickness="1"
                   Padding="8,6" FontSize="12"
                   VerticalContentAlignment="Center"
                   Text="http://localhost:3000"/>
          <Button Grid.Column="1" Content="Watch"
                  Margin="6,0,0,0"
                  Padding="10,6"
                  Background="#185FA5"
                  Foreground="White"
                  BorderThickness="0"
                  Cursor="Hand"
                  Click="WatchBrowser_Click"/>
          <Button Grid.Column="2" Content="Stop"
                  Margin="4,0,0,0"
                  Padding="10,6"
                  Background="#313244"
                  Foreground="White"
                  BorderThickness="0"
                  Cursor="Hand"
                  Click="StopBrowser_Click"/>
        </Grid>
      </Border>

      <!-- Run bar -->
      <Border Grid.Row="5" Background="#12122A"
              Padding="12,8"
              BorderBrush="#2D2D4E" BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="RunCommandBox"
                   Background="#1E1E3A"
                   Foreground="#6C7086"
                   BorderBrush="#313244" BorderThickness="1"
                   Padding="8,6" FontSize="12"
                   FontFamily="Consolas"
                   VerticalContentAlignment="Center"
                   Text="dotnet run"/>
          <Button Grid.Column="1" Content="▶ Run"
                  Margin="6,0,0,0"
                  Padding="12,6"
                  Background="#1D9E75"
                  Foreground="White"
                  BorderThickness="0"
                  Cursor="Hand"
                  Click="RunProject_Click"/>
        </Grid>
      </Border>

      <!-- Input -->
      <Border Grid.Row="6" Background="#12122A"
              CornerRadius="0,0,16,16" Padding="12,8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Attachments preview -->
          <ScrollViewer Grid.Row="0" x:Name="AttachmentScroll"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        Visibility="Collapsed"
                        Margin="0,0,0,6">
            <StackPanel x:Name="AttachmentPanel"
                        Orientation="Horizontal"/>
          </ScrollViewer>

          <!-- Input box -->
          <Border Grid.Row="1" Background="#1E1E3A" CornerRadius="12"
                  BorderBrush="#313244" BorderThickness="1">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBox x:Name="InputBox"
                       Grid.Row="0"
                       Background="Transparent"
                       Foreground="#CDD6F4"
                       BorderThickness="0"
                       Padding="12,10" FontSize="13"
                       TextWrapping="Wrap"
                       MinHeight="80"
                       MaxHeight="300"
                       AcceptsReturn="True"
                       VerticalScrollBarVisibility="Auto"
                       KeyDown="InputBox_KeyDown"/>

              <!-- Buttons -->
              <StackPanel Grid.Row="1"
                          Orientation="Horizontal"
                          HorizontalAlignment="Right"
                          Margin="8,4,8,8">
                <Button x:Name="AttachButton"
                        Content="📎"
                        Width="32" Height="32"
                        Background="Transparent"
                        Foreground="#6C7086"
                        BorderThickness="0"
                        Cursor="Hand"
                        FontSize="16"
                        ToolTip="File ya image attach karo"
                        Click="Attach_Click"/>
                <Button x:Name="SendButton"
                        Content="↑"
                        Width="32" Height="32"
                        Margin="6,0,0,0"
                        Background="#7F77DD"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        FontSize="16"
                        Click="Send_Click"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>

    </Grid>
  </Border>
</Window>