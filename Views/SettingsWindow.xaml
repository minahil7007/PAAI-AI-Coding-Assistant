<Window x:Class="PAAI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PAAI Settings"
        Width="400" Height="220"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A2E"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="16"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="12"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="12"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="PAAI Settings"
               Foreground="White" FontSize="16" FontWeight="SemiBold"/>

    <TextBlock Grid.Row="2"
               Text="Claude API Key (console.anthropic.com se lo):"
               Foreground="#9F9D96" FontSize="13"/>

    <PasswordBox Grid.Row="4" x:Name="ApiKeyBox"
                 Background="#1E1E3A" Foreground="White"
                 BorderBrush="#313244" BorderThickness="1"
                 Padding="10,8" FontSize="13"/>

    <TextBlock Grid.Row="5" x:Name="StatusText"
               Foreground="#A6E3A1" FontSize="11"
               Visibility="Collapsed"/>

    <StackPanel Grid.Row="6" Orientation="Horizontal"
                HorizontalAlignment="Right">
      <Button Content="Cancel" Margin="0,0,8,0"
              Padding="16,8" Click="Cancel_Click"
              Background="#313244" Foreground="White"
              BorderThickness="0" Cursor="Hand"/>
      <Button Content="Save" Padding="16,8"
              Click="Save_Click"
              Background="#7F77DD" Foreground="White"
              BorderThickness="0" Cursor="Hand"/>
    </StackPanel>
  </Grid>
</Window>